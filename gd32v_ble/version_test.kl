module gd32v_ble

import testing

fn test_version_is_fourteen() {
    testing.assert_eq_i32(version(), 14)
}

fn test_err_ok_is_zero() {
    testing.assert_eq_i32(err_ok(), 0)
}

fn test_gatt_uuids_and_max() {
    testing.assert_eq_i32(stop(), 0)
    testing.assert_eq_i32(gatt_clear(), 0)
    testing.assert_eq_i32(gatt_uuid16(0xFFF0, 0xFFF1), 0)
    testing.assert_eq_i32(gatt_svc_uuid16(), 0xFFF0)
    testing.assert_eq_i32(gatt_chr_uuid16(), 0xFFF1)
    testing.assert_eq_i32(gatt_value_max(), 20)
    testing.assert_eq_i32(gatt_svc_max(), 4)
}

fn test_scan_max_is_sixteen() {
    testing.assert_eq_i32(scan_max(), 16)
}
