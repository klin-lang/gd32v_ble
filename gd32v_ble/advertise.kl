/// GD32VW553 BLE — thin Klin surface over `ble_sdk.c`.
/// Engine = GigaDevice VW55x BLE SDK (`ble_init` / `app_adv_*` / `ble_gatts_*` /
/// `ble_scan_*` / `ble_conn_*` / `ble_gattc_*`, AN152). Not part of `machine_gd32v`.
/// Not `esp_ble` (ESP-IDF NimBLE).
///
/// GATT MVP (`@v0.2.0`): fixed service `0xFFF0`, char `0xFFF1`
/// (read / write / notify), value buffer max 20 bytes.
/// Central (`@v0.3.0`): active scan (max 16, dedupe by addr) + connect by index.
/// GATT client (`@v0.4.0`): discover/read/write/subscribe for 0xFFF0/0xFFF1.
/// Central / GATT client need an SDK build with those roles (e.g. msdk_ffd).
module gd32v_ble

@[link("ble_sdk.c")]
@[cimport, codename("klin_gd32v_ble_init")]
fn klin_gd32v_ble_init(): i32

@[cimport, codename("klin_gd32v_ble_advertise")]
fn klin_gd32v_ble_advertise(name: str): i32

@[cimport, codename("klin_gd32v_ble_stop_advertise")]
fn klin_gd32v_ble_stop_advertise(): i32

@[cimport, codename("klin_gd32v_ble_connected")]
fn klin_gd32v_ble_connected(): i32

@[cimport, codename("klin_gd32v_ble_advertising")]
fn klin_gd32v_ble_advertising(): i32

@[cimport, codename("klin_gd32v_ble_wait_connected")]
fn klin_gd32v_ble_wait_connected(timeout_ms: i32): i32

@[cimport, codename("klin_gd32v_ble_stop")]
fn klin_gd32v_ble_stop(): i32

@[cimport, codename("klin_gd32v_ble_gatt_set")]
fn klin_gd32v_ble_gatt_set(data: *u8, len: i32): i32

@[cimport, codename("klin_gd32v_ble_gatt_get")]
fn klin_gd32v_ble_gatt_get(out: *mut u8, max_len: i32): i32

@[cimport, codename("klin_gd32v_ble_gatt_len")]
fn klin_gd32v_ble_gatt_len(): i32

@[cimport, codename("klin_gd32v_ble_gatt_notify")]
fn klin_gd32v_ble_gatt_notify(): i32

@[cimport, codename("klin_gd32v_ble_gatt_written")]
fn klin_gd32v_ble_gatt_written(): i32

@[cimport, codename("klin_gd32v_ble_scan_start")]
fn klin_gd32v_ble_scan_start(duration_ms: i32): i32

@[cimport, codename("klin_gd32v_ble_scan_stop")]
fn klin_gd32v_ble_scan_stop(): i32

@[cimport, codename("klin_gd32v_ble_scan_count")]
fn klin_gd32v_ble_scan_count(): i32

@[cimport, codename("klin_gd32v_ble_scan_rssi")]
fn klin_gd32v_ble_scan_rssi(index: i32): i32

@[cimport, codename("klin_gd32v_ble_scan_addr_type")]
fn klin_gd32v_ble_scan_addr_type(index: i32): i32

@[cimport, codename("klin_gd32v_ble_scan_addr")]
fn klin_gd32v_ble_scan_addr(index: i32, out6: *mut u8): i32

@[cimport, codename("klin_gd32v_ble_scan_name")]
fn klin_gd32v_ble_scan_name(index: i32, out: *mut u8, max_len: i32): i32

@[cimport, codename("klin_gd32v_ble_central_connect")]
fn klin_gd32v_ble_central_connect(index: i32, timeout_ms: i32): i32

@[cimport, codename("klin_gd32v_ble_central_connected")]
fn klin_gd32v_ble_central_connected(): i32

@[cimport, codename("klin_gd32v_ble_central_wait_connected")]
fn klin_gd32v_ble_central_wait_connected(timeout_ms: i32): i32

@[cimport, codename("klin_gd32v_ble_central_disconnect")]
fn klin_gd32v_ble_central_disconnect(): i32

@[cimport, codename("klin_gd32v_ble_gattc_discover")]
fn klin_gd32v_ble_gattc_discover(timeout_ms: i32): i32

@[cimport, codename("klin_gd32v_ble_gattc_ready")]
fn klin_gd32v_ble_gattc_ready(): i32

@[cimport, codename("klin_gd32v_ble_gattc_read")]
fn klin_gd32v_ble_gattc_read(timeout_ms: i32): i32

@[cimport, codename("klin_gd32v_ble_gattc_write")]
fn klin_gd32v_ble_gattc_write(data: *u8, len: i32, timeout_ms: i32): i32

@[cimport, codename("klin_gd32v_ble_gattc_subscribe")]
fn klin_gd32v_ble_gattc_subscribe(timeout_ms: i32): i32

@[cimport, codename("klin_gd32v_ble_gattc_notified")]
fn klin_gd32v_ble_gattc_notified(): i32

@[cimport, codename("klin_gd32v_ble_gattc_get")]
fn klin_gd32v_ble_gattc_get(out: *mut u8, max_len: i32): i32

@[cimport, codename("klin_gd32v_ble_gattc_len")]
fn klin_gd32v_ble_gattc_len(): i32

/// SDK / glue success (0).
pub fn err_ok(): i32 {
    return 0
}

/// Primary service UUID (16-bit) — fixed for MVP.
pub fn gatt_svc_uuid16(): i32 {
    return 0xFFF0
}

/// Characteristic UUID (16-bit) — fixed for MVP.
pub fn gatt_chr_uuid16(): i32 {
    return 0xFFF1
}

/// Max GATT value length (bytes).
pub fn gatt_value_max(): i32 {
    return 20
}

/// Max scan results kept (deduped by address).
pub fn scan_max(): i32 {
    return 16
}

/// `ble_init` + `ble_wait_ready` + GATT svc add (once) + scan/conn callbacks.
pub fn init(): i32 {
    return klin_gd32v_ble_init()
}

/// Legacy undirected connectable advertise. GAP name copied in C.
pub fn advertise(name: str): i32 {
    return klin_gd32v_ble_advertise(name)
}

pub fn stop_advertise(): i32 {
    return klin_gd32v_ble_stop_advertise()
}

/// 1 after `wait_connected` (host stub) / GATTS connect (board).
pub fn connected(): i32 {
    return klin_gd32v_ble_connected()
}

pub fn advertising(): i32 {
    return klin_gd32v_ble_advertising()
}

/// Block until a central connects or `timeout_ms` (`-1` = forever).
/// Host stub succeeds immediately after `advertise`.
/// On-device: polls a flag set by `BLE_SRV_EVT_CONN_STATE_CHANGE_IND`.
pub fn wait_connected(timeout_ms: i32): i32 {
    return klin_gd32v_ble_wait_connected(timeout_ms)
}

pub fn stop(): i32 {
    return klin_gd32v_ble_stop()
}

/// Copy `len` bytes from `data` into the characteristic value (max `gatt_value_max()`).
pub fn gatt_set(data: *u8, len: i32): i32 {
    return klin_gd32v_ble_gatt_set(data, len)
}

/// Copy current value into `out`. Returns byte count, or negative on error.
pub fn gatt_get(out: *mut u8, max_len: i32): i32 {
    return klin_gd32v_ble_gatt_get(out, max_len)
}

pub fn gatt_len(): i32 {
    return klin_gd32v_ble_gatt_len()
}

/// Notify subscribed centrals (no-op if none).
pub fn gatt_notify(): i32 {
    return klin_gd32v_ble_gatt_notify()
}

/// True if a central wrote since last poll (flag cleared).
pub fn gatt_written(): bool {
    return klin_gd32v_ble_gatt_written() != 0
}

/// Blocking active scan for `duration_ms`. Stops advertising first.
pub fn scan_start(duration_ms: i32): i32 {
    return klin_gd32v_ble_scan_start(duration_ms)
}

pub fn scan_stop(): i32 {
    return klin_gd32v_ble_scan_stop()
}

pub fn scan_count(): i32 {
    return klin_gd32v_ble_scan_count()
}

pub fn scan_rssi(index: i32): i32 {
    return klin_gd32v_ble_scan_rssi(index)
}

pub fn scan_addr_type(index: i32): i32 {
    return klin_gd32v_ble_scan_addr_type(index)
}

/// Copy 6-byte BD_ADDR into `out6`.
pub fn scan_addr(index: i32, out6: *mut u8): i32 {
    return klin_gd32v_ble_scan_addr(index, out6)
}

/// Copy advertised name bytes (no NUL). Returns length.
pub fn scan_name(index: i32, out: *mut u8, max_len: i32): i32 {
    return klin_gd32v_ble_scan_name(index, out, max_len)
}

/// Connect as central to scan result `index` (GAP). Then `gattc_discover`.
pub fn central_connect(index: i32, timeout_ms: i32): i32 {
    return klin_gd32v_ble_central_connect(index, timeout_ms)
}

pub fn central_connected(): bool {
    return klin_gd32v_ble_central_connected() != 0
}

pub fn central_wait_connected(timeout_ms: i32): i32 {
    return klin_gd32v_ble_central_wait_connected(timeout_ms)
}

pub fn central_disconnect(): i32 {
    return klin_gd32v_ble_central_disconnect()
}

/// Discover peer svc 0xFFF0 / chr 0xFFF1 (+ CCCD if present). Blocks.
pub fn gattc_discover(timeout_ms: i32): i32 {
    return klin_gd32v_ble_gattc_discover(timeout_ms)
}

pub fn gattc_ready(): bool {
    return klin_gd32v_ble_gattc_ready() != 0
}

pub fn gattc_read(timeout_ms: i32): i32 {
    return klin_gd32v_ble_gattc_read(timeout_ms)
}

pub fn gattc_write(data: *u8, len: i32, timeout_ms: i32): i32 {
    return klin_gd32v_ble_gattc_write(data, len, timeout_ms)
}

/// Enable notifications (write CCCD 0x2902 = 0x0001). Fails if peer has no CCCD.
pub fn gattc_subscribe(timeout_ms: i32): i32 {
    return klin_gd32v_ble_gattc_subscribe(timeout_ms)
}

/// Clears on read; payload via `gattc_get` / `gattc_len`.
pub fn gattc_notified(): bool {
    return klin_gd32v_ble_gattc_notified() != 0
}

pub fn gattc_get(out: *mut u8, max_len: i32): i32 {
    return klin_gd32v_ble_gattc_get(out, max_len)
}

pub fn gattc_len(): i32 {
    return klin_gd32v_ble_gattc_len()
}
