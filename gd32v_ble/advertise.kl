/// SDK / glue success (0).
pub fn err_ok(): i32 {
    return 0
}

/// Slot 0 service UUID16 (0 if 128-bit); default `0xFFF0` if table empty.
pub fn gatt_svc_uuid16(): i32 {
    return klin_gd32v_ble_gatt_svc_uuid16()
}

/// Slot 0 characteristic UUID16 (0 if 128-bit); default `0xFFF1` if empty.
pub fn gatt_chr_uuid16(): i32 {
    return klin_gd32v_ble_gatt_chr_uuid16()
}

/// Max GATT value length (bytes).
pub fn gatt_value_max(): i32 {
    return 20
}

/// Max scan results kept (deduped by address).
pub fn scan_max(): i32 {
    return 16
}

/// Set 16-bit svc/chr on slot 0. Must run **before** `init`.
pub fn gatt_uuid16(svc_uuid16: i32, chr_uuid16: i32): i32 {
    return klin_gd32v_ble_gatt_uuid16(svc_uuid16, chr_uuid16)
}

/// Set 128-bit svc/chr on slot 0 (16 bytes LE each). Before `init`.
pub fn gatt_uuid128(svc16: *u8, chr16: *u8): i32 {
    return klin_gd32v_ble_gatt_uuid128(svc16, chr16)
}

/// Append 16-bit svc/chr (max `gatt_svc_max()`). Before `init`.
pub fn gatt_add_uuid16(svc_uuid16: i32, chr_uuid16: i32): i32 {
    return klin_gd32v_ble_gatt_add_uuid16(svc_uuid16, chr_uuid16)
}

pub fn gatt_add_uuid128(svc16: *u8, chr16: *u8): i32 {
    return klin_gd32v_ble_gatt_add_uuid128(svc16, chr16)
}

pub fn gatt_clear(): i32 {
    return klin_gd32v_ble_gatt_clear()
}

pub fn gatt_svc_count(): i32 {
    return klin_gd32v_ble_gatt_svc_count()
}

pub fn gatt_svc_max(): i32 {
    return 4
}

/// `ble_init` + `ble_wait_ready` + GATT svc add + scan/conn callbacks.
pub fn init(): i32 {
    return klin_gd32v_ble_init()
}

/// Legacy undirected connectable advertise. GAP name copied in C.
pub fn advertise(name: str): i32 {
    return klin_gd32v_ble_advertise(name)
}

pub fn stop_advertise(): i32 {
    return klin_gd32v_ble_stop_advertise()
}

/// 1 after `wait_connected` (host stub) / GATTS connect (board).
pub fn connected(): i32 {
    return klin_gd32v_ble_connected()
}

pub fn advertising(): i32 {
    return klin_gd32v_ble_advertising()
}

/// Block until a central connects or `timeout_ms` (`-1` = forever).
/// Host stub succeeds immediately after `advertise`.
/// On-device: polls a flag set by `BLE_SRV_EVT_CONN_STATE_CHANGE_IND`.
pub fn wait_connected(timeout_ms: i32): i32 {
    return klin_gd32v_ble_wait_connected(timeout_ms)
}

pub fn stop(): i32 {
    return klin_gd32v_ble_stop()
}

/// Copy `len` bytes from `data` into slot 0 (max `gatt_value_max()`).
pub fn gatt_set(data: *u8, len: i32): i32 {
    return klin_gd32v_ble_gatt_set(data, len)
}

pub fn gatt_set_at(index: i32, data: *u8, len: i32): i32 {
    return klin_gd32v_ble_gatt_set_at(index, data, len)
}

/// Copy current slot-0 value into `out`. Returns byte count, or negative on error.
pub fn gatt_get(out: *mut u8, max_len: i32): i32 {
    return klin_gd32v_ble_gatt_get(out, max_len)
}

pub fn gatt_get_at(index: i32, out: *mut u8, max_len: i32): i32 {
    return klin_gd32v_ble_gatt_get_at(index, out, max_len)
}

pub fn gatt_len(): i32 {
    return klin_gd32v_ble_gatt_len()
}

pub fn gatt_len_at(index: i32): i32 {
    return klin_gd32v_ble_gatt_len_at(index)
}

/// Notify subscribed centrals on slot 0 (no-op if none).
pub fn gatt_notify(): i32 {
    return klin_gd32v_ble_gatt_notify()
}

pub fn gatt_notify_at(index: i32): i32 {
    return klin_gd32v_ble_gatt_notify_at(index)
}

/// True if a central wrote slot 0 since last poll (flag cleared).
pub fn gatt_written(): bool {
    return klin_gd32v_ble_gatt_written() != 0
}

pub fn gatt_written_at(index: i32): bool {
    return klin_gd32v_ble_gatt_written_at(index) != 0
}

/// Blocking active scan for `duration_ms`. Stops advertising first.
pub fn scan_start(duration_ms: i32): i32 {
    return klin_gd32v_ble_scan_start(duration_ms)
}

pub fn scan_stop(): i32 {
    return klin_gd32v_ble_scan_stop()
}

pub fn scan_count(): i32 {
    return klin_gd32v_ble_scan_count()
}

pub fn scan_rssi(index: i32): i32 {
    return klin_gd32v_ble_scan_rssi(index)
}

pub fn scan_addr_type(index: i32): i32 {
    return klin_gd32v_ble_scan_addr_type(index)
}

/// Copy 6-byte BD_ADDR into `out6`.
pub fn scan_addr(index: i32, out6: *mut u8): i32 {
    return klin_gd32v_ble_scan_addr(index, out6)
}

/// Copy advertised name bytes (no NUL). Returns length.
pub fn scan_name(index: i32, out: *mut u8, max_len: i32): i32 {
    return klin_gd32v_ble_scan_name(index, out, max_len)
}

/// Connect as central to scan result `index` (GAP). Then `gattc_discover`.
pub fn central_connect(index: i32, timeout_ms: i32): i32 {
    return klin_gd32v_ble_central_connect(index, timeout_ms)
}

pub fn central_connected(): bool {
    return klin_gd32v_ble_central_connected() != 0
}

pub fn central_wait_connected(timeout_ms: i32): i32 {
    return klin_gd32v_ble_central_wait_connected(timeout_ms)
}

pub fn central_disconnect(): i32 {
    return klin_gd32v_ble_central_disconnect()
}

/// Use server-table slot `index` UUIDs for the next `gattc_discover`.
pub fn gattc_select(index: i32): i32 {
    return klin_gd32v_ble_gattc_select(index)
}

pub fn gattc_uuid16(svc_uuid16: i32, chr_uuid16: i32): i32 {
    return klin_gd32v_ble_gattc_uuid16(svc_uuid16, chr_uuid16)
}

pub fn gattc_uuid128(svc16: *u8, chr16: *u8): i32 {
    return klin_gd32v_ble_gattc_uuid128(svc16, chr16)
