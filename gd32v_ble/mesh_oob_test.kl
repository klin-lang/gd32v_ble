module gd32v_ble

import testing

fn test_oob_auth_default_none() {
    testing.assert_eq_i32(stop(), 0)
    testing.assert_eq_i32(init(), 0)
    testing.assert_eq_i32(mesh_oob_auth(), 0)
    testing.assert_eq_i32(mesh_oob_action(), 0)
    testing.assert_eq_i32(mesh_oob_auth_set(9), 0 - 1)
    testing.assert_eq_i32(mesh_oob_auth_set(3), 0 - 1)
    testing.assert_eq_i32(stop(), 0)
}

fn test_oob_static_and_auth() {
    let mut key: [16]u8

    key[0] = 1
    key[1] = 2
    key[2] = 3
    key[3] = 4
    key[4] = 5
    key[5] = 6
    key[6] = 7
    key[7] = 8
    key[8] = 9
    key[9] = 10
    key[10] = 11
    key[11] = 12
    key[12] = 13
    key[13] = 14
    key[14] = 15
    key[15] = 16
    testing.assert_eq_i32(init(), 0)
    testing.assert_eq_i32(mesh_oob_static_set(cast(*u8, &key[0]), 16), 0)
    testing.assert_eq_i32(mesh_oob_auth_set(3), 0)
    testing.assert_eq_i32(mesh_oob_auth(), 3)
    testing.assert_eq_i32(mesh_oob_auth_set(0), 0)
    testing.assert_eq_i32(stop(), 0)
}

fn test_oob_output_begin_inject() {
    let mut busy: i32
    let mut act: i32

    testing.assert_eq_i32(init(), 0)
    testing.assert_eq_i32(mesh_provisioner_enable(), 0)
    testing.assert_eq_i32(mesh_oob_auth_set(1), 0)
    testing.assert_eq_i32(mesh_prov_adv_begin(0, 2), 0)
    busy = 0
    if mesh_prov_busy() {
        busy = 1
    }
    testing.assert_eq_i32(busy, 1)
    act = mesh_oob_action()
    testing.assert_eq_i32(act, 2)
    testing.assert_eq_i32(mesh_oob_input_number(42), 0)
    busy = 0
    if mesh_prov_busy() {
        busy = 1
    }
    testing.assert_eq_i32(busy, 0)
    testing.assert(mesh_cdb_count() >= 2)
    testing.assert_eq_i32(stop(), 0)
}

fn test_oob_input_begin_display() {
    let mut n: i32
    let mut busy: i32

    testing.assert_eq_i32(init(), 0)
    testing.assert_eq_i32(mesh_provisioner_enable(), 0)
    testing.assert_eq_i32(mesh_oob_auth_set(2), 0)
    testing.assert_eq_i32(mesh_prov_adv_begin(0, 2), 0)
    testing.assert_eq_i32(mesh_oob_action(), 1)
    n = mesh_oob_number()
    testing.assert(n != 0)
    busy = 0
    if mesh_prov_busy() {
        busy = 1
    }
    testing.assert_eq_i32(busy, 1)
    // Host stub auto-completes on second busy poll.
    busy = 0
    if mesh_prov_busy() {
        busy = 1
    }
    testing.assert_eq_i32(busy, 0)
    testing.assert(mesh_cdb_count() >= 2)
    testing.assert_eq_i32(stop(), 0)
}
