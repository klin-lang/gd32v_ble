// Host-safe smoke: emit-c only (SDK stubs).
import "../../gd32v_ble" ble

fn main() {
    let mut e = ble.gatt_uuid16(0xA001, 0xA002)
    if e != ble.err_ok() {
        return
    }
    if ble.gatt_svc_uuid16() != 0xA001 {
        return
    }
    if ble.gatt_chr_uuid16() != 0xA002 {
        return
    }
    e = ble.init()
    if e != ble.err_ok() {
        return
    }
    e = ble.gatt_uuid16(0xB001, 0xB002)
    if e == ble.err_ok() {
        return
    }
    let mut seed: [1]u8
    seed[0] = 42
    e = ble.gatt_set(cast(*u8, &seed[0]), 1)
    if e != ble.err_ok() {
        return
    }
    let _len = ble.gatt_len()
    let mut buf: [20]u8
    let _n = ble.gatt_get(cast(*mut u8, &buf[0]), ble.gatt_value_max())
    let _w = ble.gatt_written()
    let _nt = ble.gatt_notify()
    let _svc = ble.gatt_svc_uuid16()
    let _chr = ble.gatt_chr_uuid16()
    e = ble.advertise("klin")
    if e != ble.err_ok() {
        return
    }
    let _a = ble.advertising()
    e = ble.wait_connected(0)
    if e != ble.err_ok() {
        return
    }
    let _c = ble.connected()
    let _sa = ble.stop_advertise()
    e = ble.scan_start(100)
    if e != ble.err_ok() {
        return
    }
    let _sc = ble.scan_count()
    let _sm = ble.scan_max()
    let mut addr: [6]u8
    let _addr = ble.scan_addr(0, cast(*mut u8, &addr[0]))
    let _rssi = ble.scan_rssi(0)
    e = ble.central_connect(0, 100)
    if e != ble.err_ok() {
        return
    }
    e = ble.central_wait_connected(0)
    if e != ble.err_ok() {
        return
    }
    let _cc = ble.central_connected()
    e = ble.gattc_discover(100)
    if e != ble.err_ok() {
        return
    }
    let _gr = ble.gattc_ready()
    e = ble.gattc_read(100)
    if e != ble.err_ok() {
        return
    }
    let _gl = ble.gattc_len()
    let mut gbuf: [20]u8
    let _gg = ble.gattc_get(cast(*mut u8, &gbuf[0]), ble.gatt_value_max())
    let mut wseed: [1]u8
    wseed[0] = 3
    e = ble.gattc_write(cast(*u8, &wseed[0]), 1, 100)
    if e != ble.err_ok() {
        return
    }
    let _gs = ble.gattc_subscribe(100)
    let _gn = ble.gattc_notified()
    e = ble.bond_passkey(123456)
    if e != ble.err_ok() {
        return
    }
    if ble.passkey() != 123456 {
        return
    }
    e = ble.bond_start()
    if e != ble.err_ok() {
        return
    }
    e = ble.wait_bonded(100)
    if e != ble.err_ok() {
        return
    }
    let _pa = ble.passkey_action()
    let _pi = ble.passkey_inject(123456)
    let _bb = ble.bonded()
    let _bc = ble.bond_count()
    let _bcl = ble.bond_clear()
    let _cd = ble.central_disconnect()
    let _v = ble.version()
    let _s = ble.stop()
}
