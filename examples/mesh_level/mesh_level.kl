// GD32VW553 BLE Mesh Gen Level + vendor via klin-lang/gd32v_ble @v0.15.0.
// mesh_enable node includes OnOff + Level + vendor button (0x0000) + vendor byte (0x0001).
//   make emit KLIN=/path/to/klin/bin/klin.dart
import "../../gd32v_ble" ble

fn main() {
    let mut e = ble.init()
    if e != ble.err_ok() {
        return
    }
    e = ble.mesh_enable()
    if e != ble.err_ok() {
        return
    }

    while true {
        if ble.mesh_level_changed() {
            let _l = ble.mesh_level()
        }
        if ble.mesh_vnd_changed() {
            let _v = ble.mesh_vnd()
        }
        if ble.mesh_vnd_byte_changed() {
            let _b = ble.mesh_vnd_byte()
        }
        if ble.mesh_onoff_changed() {
            let _o = ble.mesh_onoff()
        }
        let mut i: i32 = 0
        while i < 20000000 {
            i = i + 1
        }
    }
}
